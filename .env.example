NODE_ENV=development
APP_TIMEZONE=Europe/Moscow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moex

TINVEST_ENV=sandbox
TINVEST_BASE_URL=https://sandbox-invest-public-api.tbank.ru:443
TINVEST_SANDBOX_TOKEN=
TINVEST_READ_ONLY_TOKEN=
TINVEST_FULL_ACCESS_TOKEN=
TINVEST_SANDBOX_ACCOUNT_ID=

MOEX_ISS_BASE_URL=https://iss.moex.com/iss
MOEX_ISS_AUTH_MODE=anonymous
MOEX_ISS_TOKEN=

TRADING_MODE=research
LIVE_TRADING_ENABLED=false
GLOBAL_KILL_SWITCH=true
LOG_LEVEL=info
# Structured Live candle-stream analysis logs (API). Default off.
LIVE_CANDLE_STREAM_LOG=false
PORT=3000

# Sandbox Admin API (BL-088). Empty token keeps admin routes disabled.
ADMIN_API_TOKEN=
# auto | memory | postgres — durable journal/audit/outbox selection
SANDBOX_ADMIN_STORE=auto

# Market trigger signals (BL-106…109)
SIGNALS_TIMEFRAMES=5m,1h
SIGNALS_EVAL_MODE=close
SIGNALS_TRIGGERS=fib_pivot_approach,fib_pivot_cross
SIGNALS_APPROACH_PCT_5M=0.15
SIGNALS_APPROACH_PCT_1H=0.4
SIGNALS_FAVORITES_POLL_MS=300000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# deprecated alias for TELEGRAM_CHAT_ID
TELEGRAM_CHANNEL_ID=
TELEGRAM_TOPIC_ALERTS=
TELEGRAM_TOPIC_LOGS=
TELEGRAM_TOPIC_ERRORS=
NOTIFIER_POLL_MS=2000
